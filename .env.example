# SignConnect AI Environment Variables Template
# Copy to .env for local overrides or set in Render Dashboard

# Flask Environment
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Server Binding (automatically set by Render)
PORT=5000
HOST=0.0.0.0

# Session & Security
SESSION_COOKIE_SECURE=true
# Comma-separated allowed CORS origins (if frontend is hosted on separate domain)
# CORS_ORIGINS=https://your-custom-domain.com,https://signconnect-ai.onrender.com

# Persistence
# Defaults to backend/database/signconnect.db
# Set to /var/data/signconnect.db if Render persistent disk is attached
# DATABASE_PATH=/var/data/signconnect.db

# Machine Learning Confidence Tuning
MIN_CONFIDENCE_THRESHOLD=0.25
STABILITY_WINDOW=2

# Email & Feedback Notifications (Optional)
FEEDBACK_RECIPIENT=navyatatakuntla99@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
