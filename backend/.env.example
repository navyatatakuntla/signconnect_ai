# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=signconnect_super_secret_jwt_and_session_key_2026
PORT=5000
HOST=127.0.0.1

# Database Configuration
DATABASE_PATH=database/signconnect.db

# CORS Configuration
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000

# Model Configuration
MODEL_PATH=models/isl_model.joblib
METRICS_PATH=models/evaluation_metrics.json
MIN_CONFIDENCE_THRESHOLD=0.55
STABILITY_WINDOW=3

# Email / SMTP Configuration (for Feedback delivery)
# Feedback is sent to navyatatakuntla99@gmail.com when these are set.
# Leave blank to disable email (feedback will still be saved to the database).
#
# For Gmail: enable 2-Step Verification, then create an App Password at:
#   https://myaccount.google.com/apppasswords
# Use that 16-character App Password as SMTP_PASS (NOT your regular Gmail password).
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_char_app_password
